[Unit]
Description=Verify the QOR OS private VM display
After=systemd-modules-load.service plymouth-quit-wait.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=qor-vm-display
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/libexec/qor-os/vm_display.py
ExecStart=/usr/sbin/chvt 2
Restart=no
