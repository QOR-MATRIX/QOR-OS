{
  "description": "A person's walk through a demonstration build's two storefronts: the game for a player, its licence and where it came from; creator features on, the art pack, its update; creator features off, and the pack stays.",
  "steps": [
    { "log": "The Store opens, on its own engine and beside themes and widgets" },
    { "expect": { "path": "storefronts.available", "equals": true } },
    { "call": "launch", "args": ["store", { "page": "games" }] },
    { "waitFor": { "window": "Store", "timeout": 10000 } },
    { "wait": 1500 },
    { "expect": { "path": "store.ready", "equals": true } },
    { "expect": { "path": "store.items", "equals": 14 } },
    { "expect": { "path": "storefronts.ready", "equals": true } },
    { "expect": { "path": "storefronts.sequence", "equals": 1 } },
    { "expect": { "path": "storefronts.creatorFeatures", "equals": false } },
    { "expect": { "path": "storefronts.player", "equals": 1 } },
    { "expect": { "path": "storefronts.creator", "equals": 0 } },

    { "log": "A player finds Ember Climb, and nothing of the Creator Store" },
    { "expect": { "item": "storefrontTitle", "path": "text", "equals": "Player Store" } },
    { "expect": { "item": "storeDemonstrationNote", "path": "visible", "equals": true } },
    { "expect": { "item": "storeDemonstrationNote", "path": "text", "contains": "throwaway key" } },
    { "expect": { "item": "storeCreator", "path": "visible", "equals": false } },
    { "expect": { "item": "storeListing:org.example.demo.pack.ember-climb-art", "path": "visible", "equals": "absent" } },
    { "click": { "item": "storeListing:org.example.demo.game.ember-climb" } },
    { "wait": 900 },
    { "expect": { "item": "storeItemName", "path": "text", "equals": "Ember Climb" } },

    { "log": "Its licence and where it came from" },
    { "expect": { "item": "storeLicence", "path": "text", "equals": "Apache-2.0" } },
    { "expect": { "item": "storeLicence", "path": "textFormat", "equals": 0 } },
    { "expect": { "item": "storeProvenance:1", "path": "text", "equals": "QOR-MATRIX/demiurge-chain" } },
    { "expect": { "item": "storeProvenance:1", "path": "textFormat", "equals": 0 } },
    { "expect": { "item": "storeProvenance:7", "path": "text", "contains": "Apache-2.0" } },
    { "scroll": { "at": { "window": "Store", "part": "content", "at": [600, 400] }, "notches": 3 } },
    { "click": { "item": "storeReadLicence" } },
    { "wait": 900 },
    { "expect": { "item": "storeLicenceText", "path": "visible", "equals": true } },
    { "expect": { "item": "storeLicenceText", "path": "text", "contains": "Apache License" } },
    { "expect": { "item": "storeLicenceText", "path": "textFormat", "equals": 0 } },

    { "log": "It installs" },
    { "scroll": { "at": { "window": "Store", "part": "content", "at": [600, 400] }, "notches": -40 } },
    { "wait": 400 },
    { "click": { "item": "storeAction" } },
    { "wait": 1500 },
    { "expect": { "path": "storefronts.installed", "equals": "org.example.demo.game.ember-climb@1.0.0" } },
    { "expect": { "item": "storeAction", "path": "text", "equals": "Installed" } },
    { "expect": { "path": "store.installed", "equals": "" } },

    { "log": "Creator features go on, in Settings" },
    { "call": "launch", "args": ["settings", { "page": "store" }] },
    { "waitFor": { "window": "Settings", "timeout": 10000 } },
    { "wait": 1200 },
    { "expect": { "path": "settings.creatorFeatures", "equals": false } },
    { "click": { "item": "creatorFeaturesSwitch" } },
    { "wait": 600 },
    { "expect": { "path": "settings.creatorFeatures", "equals": true } },
    { "expect": { "path": "storefronts.creatorFeatures", "equals": true } },
    { "expect": { "path": "storefronts.creator", "equals": 1 } },

    { "log": "The Creator Store has the art pack, and it installs" },
    { "call": "launch", "args": ["store", { "page": "creator" }] },
    { "wait": 900 },
    { "expect": { "item": "storeCreator", "path": "visible", "equals": true } },
    { "expect": { "item": "storefrontTitle", "path": "text", "equals": "Creator Store" } },
    { "expect": { "item": "storeListing:org.example.demo.game.ember-climb", "path": "visible", "equals": "absent" } },
    { "click": { "item": "storeListing:org.example.demo.pack.ember-climb-art" } },
    { "wait": 900 },
    { "expect": { "item": "storeItemName", "path": "text", "equals": "Ember Climb's art" } },
    { "click": { "item": "storeAction" } },
    { "wait": 1500 },
    { "expect": { "path": "storefronts.installed", "equals": "org.example.demo.game.ember-climb@1.0.0,org.example.demo.pack.ember-climb-art@1.0.0" } },

    { "log": "The catalogue moves on, and the pack updates from 1.0.0 to 1.1.0" },
    { "call": "launch", "args": ["store", { "page": "library" }] },
    { "wait": 900 },
    { "expect": { "item": "libraryAction:org.example.demo.pack.ember-climb-art", "path": "text", "equals": "Installed" } },
    { "click": { "item": "storeNextCatalogue" } },
    { "wait": 1200 },
    { "expect": { "path": "storefronts.sequence", "equals": 2 } },
    { "expect": { "item": "libraryAction:org.example.demo.pack.ember-climb-art", "path": "text", "equals": "Update" } },
    { "expect": { "item": "libraryVersion:org.example.demo.pack.ember-climb-art", "path": "text", "contains": "1.1.0" } },
    { "click": { "item": "libraryAction:org.example.demo.pack.ember-climb-art" } },
    { "wait": 1500 },
    { "expect": { "path": "storefronts.installed", "equals": "org.example.demo.game.ember-climb@1.0.0,org.example.demo.pack.ember-climb-art@1.1.0" } },
    { "expect": { "item": "libraryAction:org.example.demo.pack.ember-climb-art", "path": "text", "equals": "Installed" } },

    { "log": "Creator features go off: the Creator Store is gone, and the pack stays" },
    { "call": "launch", "args": ["store", { "page": "creator" }] },
    { "wait": 700 },
    { "call": "launch", "args": ["settings", { "page": "store" }] },
    { "wait": 1200 },
    { "click": { "item": "creatorFeaturesSwitch" } },
    { "wait": 600 },
    { "expect": { "path": "settings.creatorFeatures", "equals": false } },
    { "expect": { "path": "storefronts.creatorFeatures", "equals": false } },
    { "expect": { "path": "storefronts.creator", "equals": 0 } },
    { "expect": { "path": "storefronts.installed", "equals": "org.example.demo.game.ember-climb@1.0.0,org.example.demo.pack.ember-climb-art@1.1.0" } },
    { "expect": { "item": "storeCreator", "path": "visible", "equals": false } },
    { "expect": { "item": "storefrontTitle", "path": "visible", "equals": "absent" } },
    { "call": "launch", "args": ["store", { "page": "library" }] },
    { "wait": 900 },
    { "expect": { "item": "libraryItem:org.example.demo.pack.ember-climb-art", "path": "visible", "equals": true } },

    { "log": "Themes and widgets were never touched" },
    { "expect": { "path": "store.ready", "equals": true } },
    { "expect": { "path": "store.items", "equals": 14 } },
    { "expect": { "path": "store.installed", "equals": "" } },

    { "close": "Settings" },
    { "waitFor": { "gone": "Settings", "timeout": 4000 } },
    { "close": "Store" },
    { "waitFor": { "gone": "Store", "timeout": 4000 } }
  ]
}
